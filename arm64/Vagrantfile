require_relative "../lib/complytime.rb"

Vagrant.configure("2") do |config|
  config.vm.box = "./centos-stream-10.box"

  config.vm.synced_folder '.', '/vagrant', disabled: true

  ComplyTime.common_provision(config)
  
  config.vm.provision "shell", name: "vbox-guest-additions", 
    path: "./provision/vbox-guest-additions.sh",
    privileged: false
end